# Postgres connection string (Neon free tier: get from neon.tech dashboard)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Redis connection string (Upstash free tier: get from upstash.com dashboard)
REDIS_URL="rediss://default:password@host:port"

# Secret used to sign JWTs (M2). Generate a long random string for real use.
JWT_SECRET="dev-placeholder-change-me"

# Port the API listens on locally / on Render
PORT=4000

# development | production
NODE_ENV=development

# Comma-separated list of origins allowed to call this API (e.g. the Vercel URL)
CORS_ORIGIN="http://localhost:3000"
