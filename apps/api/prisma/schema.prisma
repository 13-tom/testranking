// Core data model for Board Ranking — Release 1 MVP, Phase 0 + Phase 1 scope.
// Field-for-field from docs/04_database.md (the authoritative schema doc).
// Only Users/StudentProfile/academic-hierarchy tables exist so far; Question
// Bank, Test Engine, Ranking, Gamification, and Admin RBAC tables are added
// in their own future phases per docs/06_Feature_Roadmap.md. See CLAUDE.md.
//
// NOTE: docs/04_database.md also specifies raw-SQL case-insensitive unique
// indexes on Subject/Chapter/Topic names (e.g. unique on lower(name) scoped
// to parent) — deferred to the Phase 3 Question Bank migration, when these
// tables are first actively written to by admin CRUD.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

// Authentication only. Never store XP, Rank, or Class here (docs/04_database.md §5).
model User {
  id           String   @id @default(uuid())
  phone        String?  @unique
  email        String   @unique
  // BR-037: Release 1 auth for this build is email + password (overrides the
  // docs' default Mobile+OTP-only, no-password model). Kept required here
  // since password auth is how registration actually works in this build.
  passwordHash String
  role         Role     @default(STUDENT)
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastLogin    DateTime?

  studentProfile StudentProfile?

  @@map("users")
}

// Every student has exactly one StudentProfile (docs/04_database.md §6, plus
// Sprint 12.3 suspension fields).
model StudentProfile {
  id                String    @id @default(uuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName          String
  class             Int
  schoolId          String?
  school            School?   @relation(fields: [schoolId], references: [id])
  profileImage      String?
  studyPoints       Int       @default(0)
  studyLevel        Int       @default(1)
  studyStreak       Int       @default(0)
  longestStreak     Int       @default(0)
  profileCompletion Int       @default(0)
  subscriptionPlan  String?
  isSuspended       Boolean   @default(false)
  suspendedAt       DateTime?
  suspendedReason   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("student_profiles")
}

// Store each school only once; students reference schoolId (docs/04_database.md §9,
// plus Sprint 12.3 isActive addition).
model School {
  id         String   @id @default(uuid())
  schoolName String
  board      String
  city       String
  district   String
  state      String
  country    String
  postalCode String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  studentProfiles StudentProfile[]

  @@map("schools")
}

// Master data: education boards, CBSE first (docs/04_database.md §10).
model Board {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subjects Subject[]

  @@map("boards")
}

// docs/04_database.md §10a.
model Subject {
  id           String   @id @default(uuid())
  name         String
  boardId      String
  board        Board    @relation(fields: [boardId], references: [id], onDelete: Restrict)
  class        Int
  description  String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  chapters Chapter[]

  @@unique([boardId, class, name])
  @@index([class])
  @@index([boardId, class, isActive])
  @@map("subjects")
}

// docs/04_database.md §11.
model Chapter {
  id            String   @id @default(uuid())
  subjectId     String
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  name          String
  chapterNumber Int
  description   String?
  displayOrder  Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  topics Topic[]

  @@unique([subjectId, name])
  @@unique([subjectId, chapterNumber])
  @@index([subjectId, isActive])
  @@map("chapters")
}

// docs/04_database.md §11a. PRD ch.11 hierarchy: Class -> Subject -> Chapter -> Topic -> Question.
model Topic {
  id           String   @id @default(uuid())
  chapterId    String
  chapter      Chapter  @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  name         String
  description  String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([chapterId, name])
  @@index([chapterId, isActive])
  @@map("topics")
}
