// Core data model for Board Ranking — Release 1 MVP, Phase 0-4 scope.
// Field-for-field from docs/04_database.md (the authoritative schema doc).
// Ranking, Gamification, and Admin RBAC tables are added in their own
// future phases per docs/06_Feature_Roadmap.md. See CLAUDE.md.
//
// NOTE: docs/04_database.md also specifies raw-SQL functional/partial
// indexes Prisma's DSL can't express (case-insensitive unique on
// Subject/Chapter/Topic names scoped to parent; at-most-one-active-option
// and at-most-one-active-correct-option on QuestionOption; at-most-one
// active TestAttempt per student per test). These live as hand-added SQL
// in the question_bank and test_engine migrations, not here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

// Authentication only. Never store XP, Rank, or Class here (docs/04_database.md §5).
model User {
  id           String    @id @default(uuid())
  phone        String?   @unique
  email        String    @unique
  // BR-037: Release 1 auth for this build is email + password (overrides the
  // docs' default Mobile+OTP-only, no-password model). Kept required here
  // since password auth is how registration actually works in this build.
  passwordHash String
  role         Role      @default(STUDENT)
  isVerified   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLogin    DateTime?

  studentProfile StudentProfile?
  testAttempts   TestAttempt[]

  // Phase 5: Analytics (BR-043) — FK'd to User.id, not StudentProfile.id,
  // matching TestAttempt.studentId's existing FK target.
  studentAnalytics  StudentAnalytics?
  subjectAnalytics  StudentSubjectAnalytics[]
  chapterAnalytics  StudentChapterAnalytics[]
  topicAnalytics    StudentTopicAnalytics[]
  progressSnapshots StudentProgressSnapshot[]

  // Phase 6: Ranking (BR-044) — FK'd to User.id, matching the Phase 5
  // Analytics convention above, not the docs' looser "FK -> StudentProfile"
  // phrasing.
  leaderboard   Leaderboard?
  rankSnapshots RankSnapshot[]

  @@map("users")
}

// Every student has exactly one StudentProfile (docs/04_database.md §6, plus
// Sprint 12.3 suspension fields).
model StudentProfile {
  id                String    @id @default(uuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName          String
  class             Int
  schoolId          String?
  school            School?   @relation(fields: [schoolId], references: [id])
  profileImage      String?
  studyPoints       Int       @default(0)
  studyLevel        Int       @default(1)
  studyStreak       Int       @default(0)
  longestStreak     Int       @default(0)
  profileCompletion Int       @default(0)
  subscriptionPlan  String?
  isSuspended       Boolean   @default(false)
  suspendedAt       DateTime?
  suspendedReason   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("student_profiles")
}

// Store each school only once; students reference schoolId (docs/04_database.md §9,
// plus Sprint 12.3 isActive addition).
model School {
  id         String   @id @default(uuid())
  schoolName String
  board      String
  city       String
  district   String
  state      String
  country    String
  postalCode String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  studentProfiles StudentProfile[]

  @@map("schools")
}

// Master data: education boards, CBSE first (docs/04_database.md §10).
model Board {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subjects Subject[]
  tests    Test[]

  @@map("boards")
}

// docs/04_database.md §10a.
model Subject {
  id           String   @id @default(uuid())
  name         String
  boardId      String
  board        Board    @relation(fields: [boardId], references: [id], onDelete: Restrict)
  class        Int
  description  String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  chapters         Chapter[]
  testSubjects     TestSubject[]
  subjectAnalytics StudentSubjectAnalytics[]

  @@unique([boardId, class, name])
  @@index([class])
  @@index([boardId, class, isActive])
  @@map("subjects")
}

// docs/04_database.md §11.
model Chapter {
  id            String   @id @default(uuid())
  subjectId     String
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  name          String
  chapterNumber Int
  description   String?
  displayOrder  Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  topics           Topic[]
  testChapters     TestChapter[]
  chapterAnalytics StudentChapterAnalytics[]

  @@unique([subjectId, name])
  @@unique([subjectId, chapterNumber])
  @@index([subjectId, isActive])
  @@map("chapters")
}

// docs/04_database.md §11a. PRD ch.11 hierarchy: Class -> Subject -> Chapter -> Topic -> Question.
model Topic {
  id           String   @id @default(uuid())
  chapterId    String
  chapter      Chapter  @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  name         String
  description  String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  questions      Question[]
  testTopics     TestTopic[]
  topicAnalytics StudentTopicAnalytics[]

  @@unique([chapterId, name])
  @@index([chapterId, isActive])
  @@map("topics")
}

enum QuestionType {
  MCQ
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum BloomLevel {
  REMEMBER
  UNDERSTAND
  APPLY
  ANALYZE
}

enum QuestionStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  REJECTED
  ARCHIVED
}

// docs/04_database.md §13. Topic-anchored: hierarchy is derived via
// Question -> Topic -> Chapter -> Subject -> Board (no denormalized FKs).
// referenceCode is BR-008's human-readable admin/content-ops ID
// (e.g. "10M0101" = Class 10, Mathematics, Chapter 01, Question 01) —
// students never see it. Only PUBLISHED + isActive questions reach students.
model Question {
  id               String         @id @default(uuid())
  referenceCode    String         @unique
  topicId          String
  topic            Topic          @relation(fields: [topicId], references: [id], onDelete: Restrict)
  questionText     String
  questionType     QuestionType   @default(MCQ)
  image            String?
  explanation      String?
  difficulty       Difficulty
  bloomLevel       BloomLevel?
  timeLimitSeconds Int?
  positiveMarks    Float
  negativeMarks    Float          @default(0)
  status           QuestionStatus @default(DRAFT)
  language         String         @default("en")
  source           String?
  tags             String[]       @default([])
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  options          QuestionOption[]
  versions         QuestionVersion[]
  attemptQuestions AttemptQuestion[]
  studentAnswers   StudentAnswer[]

  @@index([topicId, status, isActive])
  @@index([status, isActive])
  @@index([difficulty])
  @@index([tags(ops: ArrayOps)], type: Gin)
  @@map("questions")
}

// docs/04_database.md §13a. Owned by Question (CASCADE — questions are
// never physically deleted, only archived per BR-009; options soft-delete
// via isActive). Partial unique indexes (at most one active option per
// optionKey, at most one active correct option) are raw SQL — see migration.
model QuestionOption {
  id           String   @id @default(uuid())
  questionId   String
  question     Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionKey    String
  optionText   String
  optionImage  String?
  explanation  String?
  isCorrect    Boolean  @default(false)
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([questionId, isActive])
  @@map("question_options")
}

// --- Phase 4: Test Engine ---
// BR-042: QuestionVersion and AuditLog are introduced here, narrower than
// BR-041's Phase 9 deferral — see docs/12_Product_Decisions.md BR-042.

enum TestCategory {
  CHAPTER
  SUBJECT
  FULL_SYLLABUS
  MOCK
  DAILY_CHALLENGE // schema-complete only — no generation logic (Gamification/streaks, Phase 8)
}

enum TestMode {
  PRACTICE
  RANKED
}

enum TestVisibility {
  PUBLIC
  PRIVATE
}

enum TestStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ResultPublishPolicy {
  IMMEDIATE
  AFTER_END_TIME // field exists, not enforced yet — BR-028 defers this to Sprint 6 in the source docs
  MANUAL // field exists, not enforced yet — BR-028 defers this to Sprint 6 in the source docs
}

enum RankingScope {
  NONE
  SCHOOL
  DISTRICT
  STATE
  INDIA
}

enum AttemptStatus {
  CREATED // reserved, not produced by any Release-1 code path — BR-042
  STARTED
  SUBMITTED
  AUTO_SUBMITTED
  EVALUATED
  RANKED // reserved for Phase 6 (Ranking)
  ABANDONED // reserved, not produced by any Release-1 code path — BR-042
}

// docs/04_database.md §13b, narrowed per BR-042: minimal immutable
// point-in-time Question+Options snapshot, created lazily whenever the
// Test Engine's generation algorithm pins a question onto a paper — NOT
// the full Phase 9 admin audit/versioning trail (no restore endpoints, no
// version-browsing UI). createdBy is nullable: Release-1 versions are
// system-generated at generation time, not admin edits.
model QuestionVersion {
  id            String   @id @default(uuid())
  questionId    String
  question      Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
  version       Int
  snapshot      Json
  reason        String?
  changeSummary String
  createdBy     String?
  createdAt     DateTime @default(now())

  attemptQuestions AttemptQuestion[]
  studentAnswers   StudentAnswer[]

  @@unique([questionId, version])
  @@index([questionId, createdAt])
  @@map("question_versions")
}

// docs/04_database.md §12. A Test is the blueprint from which per-attempt
// papers (AttemptQuestion rows) are generated — never a question list
// itself. Scope resolved via TestSubject/TestChapter/TestTopic at
// generation time, then pinned per attempt (never re-resolved later).
model Test {
  id                       String              @id @default(uuid())
  name                     String
  description              String?
  boardId                  String
  board                    Board               @relation(fields: [boardId], references: [id], onDelete: Restrict)
  class                    Int
  questionCount            Int
  difficultyDistribution   Json
  questionTypeDistribution Json                @default("{\"MCQ\":100}")
  positiveMarks            Float               @default(1)
  negativeMarks            Float               @default(0)
  language                 String              @default("en")
  duration                 Int
  passingMarks             Float
  shuffleQuestions         Boolean             @default(true)
  shuffleOptions           Boolean             @default(true)
  visibility               TestVisibility      @default(PUBLIC)
  category                 TestCategory
  mode                     TestMode            @default(PRACTICE)
  startTime                DateTime?
  endTime                  DateTime?
  instructions             String?
  calculatorAllowed        Boolean             @default(false)
  reviewAllowed            Boolean             @default(true)
  resultPublishPolicy      ResultPublishPolicy @default(IMMEDIATE)
  rankingScope             RankingScope        @default(NONE)
  maxAttempts              Int                 @default(1)
  status                   TestStatus          @default(DRAFT)
  isActive                 Boolean             @default(true)
  createdBy                String
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  testSubjects  TestSubject[]
  testChapters  TestChapter[]
  testTopics    TestTopic[]
  attempts      TestAttempt[]
  rankSnapshots RankSnapshot[]

  @@index([status, isActive])
  @@index([boardId, class])
  @@index([category])
  @@map("tests")
}

// docs/04_database.md §12a. Empty TestChapter rows for a test = all
// chapters of its TestSubject rows; empty TestTopic rows = all topics of
// the resolved chapters.
model TestSubject {
  testId    String
  test      Test    @relation(fields: [testId], references: [id], onDelete: Restrict)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@id([testId, subjectId])
  @@index([subjectId])
  @@map("test_subjects")
}

model TestChapter {
  testId    String
  test      Test    @relation(fields: [testId], references: [id], onDelete: Restrict)
  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Restrict)

  @@id([testId, chapterId])
  @@index([chapterId])
  @@map("test_chapters")
}

model TestTopic {
  testId  String
  test    Test   @relation(fields: [testId], references: [id], onDelete: Restrict)
  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Restrict)

  @@id([testId, topicId])
  @@index([topicId])
  @@map("test_topics")
}

// docs/04_database.md §14. expiresAt is "the ONLY deadline authority"
// (BR-027). selectionMeta is the "provenance triple" (seed,
// blueprintSnapshot, driftPp, poolSizes) that lets a generated paper
// reproduce forever. Partial unique index (at most one CREATED/STARTED
// attempt per student per test) is raw SQL — see the test_engine migration.
model TestAttempt {
  id                        String        @id @default(uuid())
  studentId                 String
  student                   User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  testId                    String
  test                      Test          @relation(fields: [testId], references: [id], onDelete: Restrict)
  status                    AttemptStatus @default(STARTED)
  selectionAlgorithmVersion String        @default("v1")
  selectionMeta             Json
  startedAt                 DateTime?
  expiresAt                 DateTime?
  sessionId                 String        @default(uuid())
  submittedAt               DateTime?
  score                     Float?
  totalMarks                Float?
  percentage                Float?
  accuracy                  Float?
  correctCount              Int?
  wrongCount                Int?
  unansweredCount           Int?
  timeTaken                 Int?
  studyPointsEarned         Int?
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  attemptQuestions AttemptQuestion[]
  studentAnswers   StudentAnswer[]

  @@index([studentId, testId])
  @@index([testId])
  @@index([status, expiresAt])
  @@index([submittedAt])
  @@map("test_attempts")
}

// docs/04_database.md §14a — the frozen paper. Points to what the bank
// immortalized (questionVersionId), snapshots what the attempt invented
// (order, option order). Scoring/rendering always read the pinned
// snapshot, never the live Question/QuestionOption rows.
model AttemptQuestion {
  attemptId         String
  attempt           TestAttempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId        String
  question          Question        @relation(fields: [questionId], references: [id], onDelete: Restrict)
  questionVersionId String
  questionVersion   QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Restrict)
  displayOrder      Int
  optionOrder       Json

  @@id([attemptId, questionId])
  @@unique([attemptId, displayOrder])
  @@index([questionId])
  @@index([questionVersionId])
  @@map("attempt_questions")
}

// docs/04_database.md §15. One row per question per attempt. answerSequence
// is a client-generated monotonic counter — the server rejects writes
// where clientSequence <= the stored value (409 STALE_ANSWER, mapped to
// ConflictError). clientRequestId makes retried writes idempotent.
// markedForReview added per PRD Ch12 §10's Review Screen — not in
// docs/04_database.md §15's literal field list, recorded in BR-042.
model StudentAnswer {
  id                String          @id @default(uuid())
  attemptId         String
  attempt           TestAttempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId        String
  question          Question        @relation(fields: [questionId], references: [id], onDelete: Restrict)
  questionVersionId String
  questionVersion   QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Restrict)
  selectedOptionKey String?
  markedForReview   Boolean         @default(false)
  answerSequence    Int
  clientRequestId   String          @unique
  answeredAt        DateTime        @default(now())
  isCorrect         Boolean?
  marksAwarded      Float?
  updatedAt         DateTime        @updatedAt

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@map("student_answers")
}

// docs/04_database.md §24, narrowed per BR-042: minimal slice, only the
// TEST_SUBMITTED event (BR-026), written atomically with the evaluation
// transaction. No admin log-browsing UI (Phase 9). eventType is a plain
// string, not an enum, so future event types don't need a migration.
model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  eventType  String
  entityType String
  entityId   String
  metadata   Json
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// --- Phase 6: Ranking System (BR-029 through BR-036, BR-044) ---
// docs/04_database.md §16/§16a. Written exclusively by
// ranking-calculation.service.ts's triggerRankingForAttempt(attemptId),
// fire-and-forget after each evaluated ranked-mode attempt (mirroring the
// Phase 5 Analytics writer pattern above). FK target is User.id, matching
// every existing studentId FK in this schema (BR-044 reconciles the docs'
// looser "FK -> StudentProfile" phrasing).

// ALL_TIME rank cache only, one row per student. The four rank columns are
// FROZEN (BR-029) — future scopes (CITY/FRIENDS/CUSTOM) must never add new
// columns here; they read from RankSnapshot instead.
model Leaderboard {
  id           String   @id @default(uuid())
  studentId    String   @unique
  student      User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  period       String   @default("ALL_TIME")
  schoolRank   Int?
  districtRank Int?
  stateRank    Int?
  indiaRank    Int?
  studyPoints  Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@index([schoolRank])
  @@index([districtRank])
  @@index([stateRank])
  @@index([indiaRank])
  @@index([studyPoints])
  @@map("leaderboard")
}

// The immutable historical audit trail (BR-031). One row per (studentId,
// scope, scopeId, period, rankingVersion) tuple, never updated. scope/
// scopeId are open strings (not enums), by design (BR-029), so future
// scope types never require a migration. scopeId is always sourced from
// the canonical School columns at calculation time (BR-030), never from
// caller input.
model RankSnapshot {
  id             String    @id @default(uuid())
  studentId      String
  student        User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  scope          String
  scopeId        String
  rank           Int
  totalStudents  Int       @default(0)
  studyPoints    Int
  period         String    @default("ALL_TIME")
  academicYear   String
  rankingVersion Int       @default(1)
  testId         String?
  test           Test?     @relation(fields: [testId], references: [id], onDelete: SetNull)
  isPublished    Boolean   @default(false)
  computedAt     DateTime  @default(now())
  publishedAt    DateTime?

  @@index([studentId, scope, period, computedAt])
  @@index([scope, scopeId, period, rankingVersion, rank])
  @@index([isPublished, computedAt])
  @@map("rank_snapshots")
}

// --- Phase 5: Analytics (BR-043) ---
// docs/04_database.md §16b-16f. All 5 tables are pre-computed/read-only
// from the API's perspective — the sole writer is
// analytics.service.ts's triggerAnalyticsUpdate(studentId), a full
// idempotent recompute run fire-and-forget after each evaluated attempt
// (apps/api/src/services/test-attempt.service.ts's evaluateClaimedAttempt).
// FK target is User.id (not StudentProfile.id as literally listed in the
// docs) per BR-043, matching TestAttempt.studentId's existing FK target —
// and, also matching TestAttempt's onDelete: Cascade (not Restrict as
// literally listed in the docs), since these rows are pure derived/
// computed caches: deleting a User should clean up their analytics
// automatically rather than being blocked by them.

model StudentAnalytics {
  id                String    @id @default(uuid())
  studentId         String    @unique
  student           User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  testsTaken        Int       @default(0)
  testsCompleted    Int       @default(0)
  questionsSolved   Int       @default(0)
  correctAnswers    Int       @default(0)
  incorrectAnswers  Int       @default(0)
  accuracy          Float     @default(0)
  averageScore      Float     @default(0)
  averagePercentage Float     @default(0)
  bestPercentage    Float     @default(0)
  bestScore         Float     @default(0)
  averageRank       Int? // null until Phase 6 (Ranking) exists — BR-043
  bestRank          Int? // null until Phase 6 (Ranking) exists — BR-043
  totalStudyTime    Int       @default(0)
  lastTestDate      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("student_analytics")
}

model StudentSubjectAnalytics {
  id                     String   @id @default(uuid())
  studentId              String
  student                User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId              String
  subject                Subject  @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  attempts               Int      @default(0)
  questionsSolved        Int      @default(0)
  correctAnswers         Int      @default(0)
  incorrectAnswers       Int      @default(0)
  accuracy               Float    @default(0)
  averageTimePerQuestion Float    @default(0) // BR-043: approximated as attempt.timeTaken / questionsInAttempt
  bestScore              Float    @default(0)
  averageScore           Float    @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([studentId, subjectId])
  @@map("student_subject_analytics")
}

// weaknessScore here (= 100 - accuracy) is a distinct value from Module
// 16's composite "weaknessScore" response field, which uses this column
// only as one input (masteryPenalty) — never re-exposed under this name
// in Module 16 responses. See BR-043.
model StudentChapterAnalytics {
  id                     String   @id @default(uuid())
  studentId              String
  student                User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  chapterId              String
  chapter                Chapter  @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  attempts               Int      @default(0)
  questionsSolved        Int      @default(0)
  correctAnswers         Int      @default(0)
  incorrectAnswers       Int      @default(0)
  accuracy               Float    @default(0)
  averageTimePerQuestion Float    @default(0)
  weaknessScore          Float    @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([studentId, chapterId])
  @@index([studentId, weaknessScore])
  @@map("student_chapter_analytics")
}

model StudentTopicAnalytics {
  id                     String   @id @default(uuid())
  studentId              String
  student                User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topicId                String
  topic                  Topic    @relation(fields: [topicId], references: [id], onDelete: Restrict)
  attempts               Int      @default(0)
  questionsSolved        Int      @default(0)
  correctAnswers         Int      @default(0)
  incorrectAnswers       Int      @default(0)
  accuracy               Float    @default(0)
  averageTimePerQuestion Float    @default(0)
  masteryScore           Float    @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([studentId, topicId])
  @@index([studentId, masteryScore])
  @@map("student_topic_analytics")
}

// Cumulative-as-of-date snapshot (not single-day stats) — BR-043. One row
// per distinct calendar date the student has ever submitted an evaluated
// attempt on; recomputed fully on every aggregation run. studyPoints is
// cumulative sum of TestAttempt.studyPointsEarned as-of that date (not a
// snapshot of StudentProfile.studyPoints, which has no historical ledger).
model StudentProgressSnapshot {
  id                String   @id @default(uuid())
  studentId         String
  student           User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date              DateTime // truncated to UTC day
  rank              Int? // null until Phase 6 (Ranking) exists — BR-043
  accuracy          Float    @default(0)
  averageScore      Float    @default(0)
  averagePercentage Float    @default(0)
  studyPoints       Int      @default(0)
  testsTaken        Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([studentId, date])
  @@index([studentId, date])
  @@map("student_progress_snapshots")
}
